# ==========================================
# ShipOrDie Environment Configuration
# ==========================================

# --- APP ---
NEXTAUTH_SECRET=35c75abf1df64379ba92ee2c8ab2717a
NEXTAUTH_URL=http://localhost:3000

# --- OAuth Credentials ---
GOOGLE_CLIENT_ID=google_client_id_placeholder
GOOGLE_CLIENT_SECRET=google_client_secret_placeholder
GITHUB_CLIENT_ID=github_client_id_placeholder
GITHUB_CLIENT_SECRET=github_client_secret_placeholder

# --- Database & Redis ---
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/shipordie
REDIS_URL=redis://localhost:6379/0

# --- Vector Database ---
CHROMA_HOST=localhost
CHROMA_PORT=8002

# --- LLM Service ---
# Set base URL if using local Ollama, or use Groq API key
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=groq_api_key_placeholder

# --- Billing & Payments ---
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# --- Cloudflare R2 Storage ---
R2_BUCKET_NAME=shipordie-exports
R2_ACCOUNT_ID=r2_account_id_placeholder
R2_ACCESS_KEY_ID=r2_access_key_id_placeholder
R2_SECRET_ACCESS_KEY=r2_secret_access_key_placeholder

# --- Resume Builder ---
RESUME_AI_SCORE_THRESHOLD=0.30
RESUME_MAX_RETRIES=3
WEASYPRINT_ENABLED=true
